# DataCube AU frontend/server runtime environment example.
# Values belong in deployment secret storage or local ignored .env files.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=
NEXT_PUBLIC_SUPPORT_EMAIL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PROVIDER_KEY_ENCRYPTION_SECRET=
VPS_SHARED_SECRET=
VPS_AI_GATEWAY_URL=

# Use CRON_SECRET for Vercel Cron authorization, or RETENTION_CRON_SECRET
# when intentionally using a separate app-level retention secret.
CRON_SECRET=
RETENTION_CRON_SECRET=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
