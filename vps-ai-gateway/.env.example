# ═══════════════════════════════════════════════════════════════════════════
# VPS AI Gateway — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# ── Qdrant Vector Database ───────────────────────────────────────────────
QDRANT_URL=https://your-qdrant-endpoint
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION=au_chunks

# ── AI Provider API Keys (REQUIRED — at least one) ──────────────────────
OPENROUTER_API_KEY=your-openrouter-key
# ANTHROPIC_API_KEY=your-anthropic-key

# ── Server Configuration ────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
ALLOWED_ORIGINS=https://datacube.au
RATE_LIMIT_MAX_PER_MINUTE=20
QDRANT_TIMEOUT_MS=8000
AI_PROVIDER_TIMEOUT_MS=60000
AI_CONTEXT_CHAR_LIMIT=12000
AI_MAX_OUTPUT_TOKENS=2048

# ── Debug (set to 1 for verbose logging) ─────────────────────────────────
DEBUG=0

# ── App URL (for HTTP Referer header sent to AI providers) ──────────────
APP_URL=https://datacube.au
