
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.39.0";
import { corsHeaders } from "../_shared/cors.ts";
import * as postgres from "https://deno.land/x/postgres@v0.17.0/mod.ts";

const supabaseUrl = Deno.env.get("SUPABASE_URL")!;
const supabaseServiceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
const databaseUrl = Deno.env.get("SUPABASE_DB_URL")!;

const supabaseAdmin = createClient(supabaseUrl, supabaseServiceKey);

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  try {
    const { action, ...body } = await req.json();

    if (action === "apply_schema_migration") {
      // Connect to DB directly
      const pool = new postgres.Pool(databaseUrl, 3, true);
      const connection = await pool.connect();
      try {
        await connection.queryObject`ALTER TABLE au_api_keys ADD COLUMN IF NOT EXISTS allowed_models TEXT[] DEFAULT NULL;`;
        return new Response(JSON.stringify({ ok: true, message: "Migration applied" }), { headers: corsHeaders });
      } finally {
        connection.release();
      }
    }
    
    // ... existing code ...
