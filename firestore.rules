rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is admin via 'admins' collection existence
    function isAdmin() {
       return request.auth != null && (
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'fabiansazzy1214@gmail.com' // Keep fallback for safety
       );
    }

    // Helper: Check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- 1. SUPPORT THREADS ---
    // Collection: /support_threads/{threadId}
    match /support_threads/{threadId} {
      // Allow read if owner or admin
      allow read: if isOwner(resource.data.owner_id) || isAdmin();
      // Writes strictly via Edge Functions (Service Account) usually, 
      // but if we want optimistic UI, we might allow creation?
      // User spec says: "ALL message/broadcast writes MUST go through Supabase Edge Functions"
      // So client-side WRITE should be DENIED.
      allow write: if false; 

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/support_threads/$(threadId)).data.owner_id) || isAdmin();
        allow write: if false; // Via Edge Function
      }
    }

    // --- 2. BROADCASTS ---
    match /broadcasts/{broadcastId} {
      // Users can read broadcasts
      allow read: if request.auth != null;
      // Only admins can write broadcasts (via Edge Function, but if we allowed client admin writes...)
      // Spec says: "Users cannot edit/delete broadcasts"
      // Spec says: "Only admins can read ALL support threads... + create broadcasts"
      // Since writes are via Edge Functions, we deny writes here too.
      allow write: if false; 

      match /replies/{replyId} {
        // Admin sees all, User sees OWN
        allow read: if isOwner(resource.data.owner_id) || isAdmin();
        allow write: if false; // Via Edge Function
      }
    }

    // --- 3. NOTIFICATION STATE ---
    match /users/{userId}/notification_state/inbox {
      allow read: if isOwner(userId);
      allow write: if false; // Via Edge Function
    }
    
    // --- 4. LEGACY / OTHER ---

    // Match conversation messages (Legacy/Support - Keeping for migration if needed, or remove?)
    // User says "Both Support Chat and Broadcast must use Firestore only. If any Supabase tables exist... remove code paths."
    // But this is Firestore legacy. I'll leave it readable for migration tools but deny write?
    match /conversations/{userId}/messages/{messageId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; 
    }

    // Memory System
    match /users/{userId}/memory/{docId} {
      allow read, write: if isOwner(userId);
    }

    // AU Threads
    match /users/{userId}/au_threads/{threadId} {
      allow read, write: if isOwner(userId);
    }
    
    // Jobs (for background chat)
    match /users/{userId}/jobs/{jobId} {
        allow read, write: if isOwner(userId);
    }

    // Global Threads
    match /users/{userId}/global_threads/{threadId} {
      allow read, write: if isOwner(userId);
    }

    // Admins Collection (Read-only for users to check? No, used by isAdmin function)
    match /admins/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
